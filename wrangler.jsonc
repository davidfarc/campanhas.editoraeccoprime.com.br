{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "campanhas-editoraeccoprime-com-br",
  "compatibility_date": "2026-11-10",
  "main": "./src/index.js",
  "observability": { "enabled": true },

  // Destino dos leads no Spotter. Nao sao segredos, entao ficam versionados
  // aqui em vez do painel: assim o deploy sempre aplica o mesmo destino.
  // So o SPOTTER_TOKEN e secret.
  "vars": {
    "SPOTTER_FUNNEL_NAME": "Editora Eccoprime Site Educativo",
    // Cada formulario entra na sua propria etapa.
    "SPOTTER_STAGES": {
      "aula-experimental": "Entrada Aula Experimental",
      "apresentacao-material": "Entrada Apresentação Material"
    }
  },

  // Dominio proprio. O DNS da zona ja esta na Cloudflare, entao o
  // registro de campanhas. e criado sozinho no primeiro deploy.
  "routes": [
    { "pattern": "campanhas.editoraeccoprime.com.br", "custom_domain": true }
  ],

  // Só o conteúdo de public/ vai ao ar. Nada mais do repositório
  // (.git, LEIA-ME, configuração) é publicado.
  "assets": {
    "directory": "./public",
    // /aula-experimental → /aula-experimental/index.html
    "binding": "ASSETS",
    // So /api/* passa pelo Worker; o resto e servido como arquivo.
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
